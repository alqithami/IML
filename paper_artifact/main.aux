\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Per-agent fairness analysis of IML enforcement events across five training seeds. Sanctions/ep.\ reports the mean number of pre-review flagged sanction events per agent per episode. TP/ep. and FP/ep. partition those flagged events into true violations and false positives, respectively. Overturn Rate is the fraction of flagged events reversed by the review mechanism, so net upheld sanctions are approximately Sanctions/ep.\ $\times $ $(1-\text  {Overturn Rate})$. Gini coefficients near zero indicate near-perfect equity in the distribution of pre-review enforcement burden across agents.}}{24}{table.caption.15}\protected@file@percent }
\newlabel{tab:fairness}{{8}{24}{Per-agent fairness analysis of IML enforcement events across five training seeds. Sanctions/ep.\ reports the mean number of pre-review flagged sanction events per agent per episode. TP/ep. and FP/ep. partition those flagged events into true violations and false positives, respectively. Overturn Rate is the fraction of flagged events reversed by the review mechanism, so net upheld sanctions are approximately Sanctions/ep.\ $\times $ $(1-\text {Overturn Rate})$. Gini coefficients near zero indicate near-perfect equity in the distribution of pre-review enforcement burden across agents}{table.caption.15}{}}
\newlabel{tab:fairness@cref}{{[table][8][]8}{[1][24][]24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Per-agent sanction distribution.} Left: \textsc  {Cleanup}. Right: \textsc  {Harvest}. In these symmetric environments, flagged sanction counts and false-positive burden remain tightly clustered across the five agents.}}{25}{figure.caption.16}\protected@file@percent }
\newlabel{fig:fairness_per_agent_boxplot}{{8}{25}{\textbf {Per-agent sanction distribution.} Left: \textsc {Cleanup}. Right: \textsc {Harvest}. In these symmetric environments, flagged sanction counts and false-positive burden remain tightly clustered across the five agents}{figure.caption.16}{}}
\newlabel{fig:fairness_per_agent_boxplot@cref}{{[figure][8][]8}{[1][24][]25}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Temporal composition of sanctions.} Early in training, true violations contribute materially to sanctions. Later, as compliance improves, the remaining burden is dominated by false positives.}}{25}{figure.caption.17}\protected@file@percent }
